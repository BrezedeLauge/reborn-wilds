{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dungeons Alive quest definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "objectives"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "description": {"type": "string", "maxLength": 2048},
    "icon": {"$ref": "#/$defs/resourceId"},
    "order": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
    "experience": {"type": "integer", "minimum": 0, "maximum": 100000},
    "prerequisites": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/resourceId"}},
    "requires_mods": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
    "objectives": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/objective"}},
    "rewards": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/reward"}}
  },
  "$defs": {
    "resourceId": {"type": "string", "maxLength": 256, "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "target"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_.-]{1,64}$"},
        "type": {"enum": ["kill_entity", "visit_biome", "collect_item"]},
        "target": {"$ref": "#/$defs/resourceId"},
        "amount": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "label": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"}
      },
      "allOf": [{"if": {"properties": {"type": {"const": "visit_biome"}}}, "then": {"properties": {"amount": {"const": 1}}}}]
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item"],
      "properties": {
        "item": {"$ref": "#/$defs/resourceId"},
        "count": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    }
  }
}
